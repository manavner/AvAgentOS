# AvAgentOS Configuration
# Copy this to .env and fill in your values

# ── Anthropic / Claude (optional) ─────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-opus-4-7

# ── Google / Gemini (optional) ────────────────────────────────────
GOOGLE_API_KEY=your_google_key_here
GEMINI_MODEL=gemini-2.0-flash

# You can use EITHER or BOTH keys.
# If a key is missing the agent shows "NO KEY" status.

# ── Server ────────────────────────────────────────────────────────
PORT=3131

# ── Optional: shared system prompt for all built-in AI agents ─────
# SYSTEM_PROMPT=You are an AI mission controller...
